# EC2 의 ~/tech-blog-neo/deploy/.env 로 복사해 채운다. 저장소에 올리지 않는다.
DOMAIN=blog.example.com
DOCKERHUB_USERNAME=

POSTGRES_USER=techlog
POSTGRES_PASSWORD=
POSTGRES_DB=techlog

JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=-
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# 커버 이미지 S3. 버킷은 공개 읽기, 키는 s3:ListBucket 만 있으면 된다.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_COVER_PREFIX=covers/
